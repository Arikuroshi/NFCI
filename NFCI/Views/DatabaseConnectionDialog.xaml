<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NFCI.Views.DatabaseConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configure PostgreSQL connection"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            Margin="0,0,0,12"
            Text="Provider: PostgreSQL (including Neon)"
            FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Host" />
        <TextBox x:Name="HostTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="Port" />
        <TextBox x:Name="PortTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="5432" />

        <TextBlock Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="Database" />
        <TextBox x:Name="DatabaseTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" Margin="0,0,12,8" VerticalAlignment="Center" Text="Username" />
        <TextBox x:Name="UsernameTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="5" Margin="0,0,12,8" VerticalAlignment="Center" Text="Password" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

        <StackPanel
            Grid.Row="6"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,8,0"
                IsCancel="True"
                Content="Cancel" />
            <Button
                Width="90"
                IsDefault="True"
                Click="Connect_Click"
                Content="Connect" />
        </StackPanel>
    </Grid>
</Window>
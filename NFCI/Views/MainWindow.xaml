<Window
    x:Class="NFCI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:NFCI.Views"
    mc:Ignorable="d"
    Title="NFCI"
    Height="560"
    Width="860"
    MinHeight="480"
    MinWidth="700">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Read tags" Click="ReadTagsMenuItem_Click" />
                <MenuItem Header="_Write tags" Click="WriteTagsMenuItem_Click" />
                <MenuItem Header="_Loan system" Click="LoanSystemMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Manage keys" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_Database">
                <MenuItem Header="_Configure connection..." Click="ConfigureDatabaseMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <TabControl
            x:Name="MainTabs"
            Margin="12">
            <TabItem Header="Read tags">
                <views:ReadTagsView DataContext="{Binding ReadTags}" />
            </TabItem>

            <TabItem Header="Write tags">
                <views:WriteTagsView DataContext="{Binding WriteTags}" />
            </TabItem>

            <TabItem Header="Loan system">
                <views:LoanSystemView DataContext="{Binding LoanSystem}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
